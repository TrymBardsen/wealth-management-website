# Copy to api/.env and fill in. api/.env is git-ignored - never commit real keys.
ANTHROPIC_API_KEY=
# Optional: model used for AI reports (default: claude-opus-5-5)
REPORT_MODEL=claude-opus-5-5
# Optional: Neon/Postgres connection string for the AI interaction log
# (table ai_interactions). Without it, questions are kept in memory only.
DATABASE_URL=
# Password for the advisor view (/advisor). Without it the view is closed.
ADVISOR_PASSWORD=
